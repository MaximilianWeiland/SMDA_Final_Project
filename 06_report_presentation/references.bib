	file = {Castanho Silva et al. - 2024 - Modulation of Democracy Partisan Communication Du.pdf:/Users/maxweiland/Zotero/storage/PQ6SM2F2/Castanho Silva et al. - 2024 - Modulation of Democracy Partisan Communication Du.pdf:application/pdf},
}

